# 交叉编译产物（build.sh 可重建）
board/build/

# RKNN 转换的中间产物（check0/check2/check3 中间图、INT8 标定目录，30MB+）
outputs/rknn*_build/

# mAP 评估的 GT 缓存（5.6MB）：eval_map.py 从 val2017 的 YOLO 标签确定性重建
outputs/map_gt.json

# 板端评估图片子集（31MB）与各阈值的 RKNN 构建产物：脚本可确定性重建
outputs/board_eval_images/
outputs/map_build_*/

# 真机归因的原始张量 dump（diff_raw.py 随时可重新抓取）
outputs/*.int8*

# 板端批量评估的原始检出（28~50MB；mAP 报告 map_*_full.json 入库，检出可重跑重建）
outputs/board_*_full.json

# 评估过程日志（结论都在 map_*.json 报告里）
outputs/*.log

# 板端原始输出：verify_*.py 会把它转成统一 schema 的 stage 文件后即无用
outputs/*_raw.json
outputs/board_out.json

# 模型与权重不进仓库，README「复现」一节的 src/ 流水线可完整重建：
#   yolo26n.pt        ultralytics 官方下载
#   yolo26n.onnx      python3 src/export_onnx.py
#   yolo26n-rk3588.rknn + metadata.yaml   python3 src/export_rknn.py
models/

# Python
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
